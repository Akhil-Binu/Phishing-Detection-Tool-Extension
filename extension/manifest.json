{
  "manifest_version": 3,
  "name": "Phishing Detector AI",
  "version": "1.0.0",
  "description": "Real-time AI and Heuristic Phishing Detection for URLs and Emails.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
